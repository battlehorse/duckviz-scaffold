# The browser app as a container, for Cloud Run: see docs/guides/hosting.md.
# It reads the contract's views from MotherDuck ({{ env_prefix }}_APP_DB, MOTHERDUCK_TOKEN), so no personal file goes
# in the image: .dockerignore lets in only the code.
FROM python:3.14-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /bin/uv
# git: uv fetches duckkit (the scaffold's kit) from GitHub
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project  # the dependencies: a layer that survives code changes
COPY .streamlit ./.streamlit
COPY src ./src
RUN uv sync --frozen --no-dev

RUN useradd --create-home app
USER app
RUN python -c "import duckdb; duckdb.connect().execute('INSTALL motherduck')"  # so a cold start downloads nothing

ENV {{ env_prefix }}_APP_DB=md:{{ motherduck_db }}
# Cloud Run sends traffic to $PORT. The flags override .streamlit/config.toml's localhost-only address, and serve
# app/static/ (the page an idle tab goes to: duckkit.app.common.watch_idle).
CMD ["sh", "-c", "exec streamlit run src/{{ package }}/app/main.py --server.port=${PORT:-8080} --server.address=0.0.0.0 --server.fileWatcherType=none --server.enableStaticServing=true"]
