# Copy to .env (gitignored) and fill in. Everything personal lives in .env only; the environment overrides it.
{%- if motherduck %}
MOTHERDUCK_TOKEN=          # optional: `{{ project_name }} publish` (MotherDuck → Settings → Access tokens)
{%- endif %}
{%- if backup %}
{{ env_prefix }}_BACKUP_DIR=   # optional: where backups go (default backups/)
{%- endif %}
{{ env_prefix }}_PRIVACY_TERMS=  # optional: more words privacy-check refuses, comma-separated
