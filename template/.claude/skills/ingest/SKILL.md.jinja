  Use when the user says things like "ingest", "load the new files", "update the data", "refresh the database".
argument-hint: "[files…]"
allowed-tools: Bash(uv run {{ project_name }} ingest *) Bash(uv run {{ project_name }} status){% if backup %} Bash(uv run {{ project_name }} backup) Bash(uv run {{ project_name }} status --remote){% endif %}
