"""The `{{ project_name }}` command line: this app's own commands, plus duckkit's standard ones (docs/cli.md)."""
{% if curations %}
from collections.abc import Iterator
from contextlib import contextmanager
from datetime import date
{%- endif %}
from pathlib import Path
from typing import Annotated

import duckdb
import typer
from duckkit.cli import add_standard_commands, contract_line
{%- if curations %}
from duckkit.curated import Refused
{%- endif %}
{%- if curations and llm %}
from duckkit.llm import DEFAULT_MODEL, SMALL_RUN
{%- endif %}

{% if curations -%}
from {{ package }}.curated import curating, restore
{% endif -%}
from {{ package }}.db.store import connect
from {{ package }}.spec import SPEC

app = typer.Typer(help="{{ description }}")
{%- if curations %}


@contextmanager
def friendly_errors(caught: type[Exception] = ValueError) -> Iterator[None]:
    """Show a `caught` error (a refusal, a bad argument) as one line, and exit with 1. Other errors keep their
    traceback."""
    try:
        yield
    except caught as e:
        typer.echo(f"✗ {e}", err=True)
        raise typer.Exit(1) from None
{%- endif %}


@app.command()
def ingest(
    paths: Annotated[list[Path], typer.Argument(exists=True, dir_okay=False, help="CSV files with day,value.")],
) -> None:
    """Load files into the database. Re-running is safe: rows already stored are left as they are."""
    from {{ package }}.ingest.pipeline import run

    with {% if curations %}friendly_errors(Refused), curating(){% else %}connect(){% endif %} as con:
        summary = run(con, paths)
        typer.echo(f"  {summary['files']} files, {summary['new']} new rows")
        for error in summary["errors"]:
            typer.echo(f"  ✗ {error}", err=True)
{%- if curations %}
        if restored := restore(con):  # a rebuilt database: the decisions come back from curated/
            typer.echo("  restored from curated/: " + ", ".join(f"{n} {table}" for table, n in restored.items()))
{%- endif %}
        problems = SPEC.contract.check(con)
    contract_line(SPEC, problems)
    if summary["errors"] or problems:
        raise typer.Exit(1)
{%- if curations %}


@app.command()
def label(
    day: Annotated[str, typer.Argument(help="The day, YYYY-MM-DD.")],
    text: Annotated[str, typer.Argument(help="What was special about it (a holiday, a broken meter).")],
    note: str | None = typer.Option(None, help="Why, for later."),
) -> None:
    """Label a day, or change its label: a decision by hand, kept in curated/labels.csv."""
    with friendly_errors(), curating() as con:
        con.execute("INSERT OR REPLACE INTO labels VALUES (?, ?, 'manual', now(), ?)",
                    [date.fromisoformat(day), text, note])
    typer.echo(f"Labelled {day}: {text}")


@app.command()
def unlabel(day: Annotated[str, typer.Argument(help="The day, YYYY-MM-DD.")]) -> None:
    """Remove a day's label."""
    with friendly_errors(), curating() as con:
        gone = con.execute("DELETE FROM labels WHERE day = ?", [date.fromisoformat(day)]).fetchone()[0]
    typer.echo(f"Removed the label of {day}" if gone else f"{day} has no label")
{%- endif %}
{%- if demo_data %}


@app.command()
def demo(
    seed: int = typer.Option(1, help="Random seed: the same seed gives the same database."),
    days: int = typer.Option(90, help="Days of made-up readings."),
    out: Annotated[Path | None, typer.Option(
        help="Database to write (default: data/demo.duckdb). Only ever replaces a demo database.")] = None,
) -> None:
    """Build the demo database: made-up data for screenshots and demos. Open it with `{{ project_name }} app --demo`."""
    from duckkit.demo import build_demo

    from {{ package }}.demo import fill, params_toml

    try:
        path = build_demo(SPEC, connect, lambda con: fill(con, seed, days), params_toml(seed, days),
                          path=out)
    except ValueError as e:
        typer.echo(f"✗ {e}", err=True)
        raise typer.Exit(1) from None
    typer.echo(f"Wrote {path} ({days} days, seed {seed})")
{%- endif %}

{%- if curations and llm %}


@app.command()
def classify(
    limit: Annotated[int | None, typer.Option(min=1, help="Label at most this many days (a cheap trial).")] = None,
    model: Annotated[str, typer.Option(help="The Claude model.")] = DEFAULT_MODEL,
    yes: Annotated[bool, typer.Option("--yes", help=f"Run even with over {SMALL_RUN} days waiting (it costs money).")] = False,
) -> None:
    """Label the days whose value stands out, with Claude. A large run needs --yes."""
    from duckkit.llm import Claude, LLMError, cost_gate

    from {{ package }} import classify as labeller

    with friendly_errors(LLMError), friendly_errors(Refused), curating() as con:
        waiting = labeller.days_to_label(con)
        days = waiting[:limit]
        if not days:
            typer.echo("No day to label.")
            return
        command = "classify" + (f" --limit {limit}" if limit else "")
        command += f" --model {model}" if model != DEFAULT_MODEL else ""
        what = "1 day" if len(days) == 1 else f"{len(days)} days"
        what += f" of the {len(waiting)} waiting" if len(days) < len(waiting) else ""
        # The gate counts every day waiting, so a large run split with --limit still needs --yes.
        if not cost_gate(SPEC, what, len(waiting), labeller.estimate(days, model), yes, command):
            return
        claude = Claude(SPEC, model=model)
        try:
            labelled = labeller.classify(con, claude, days)
        finally:
            typer.echo(claude.usage.line())
    sent = "the day sent" if len(days) == 1 else f"the {len(days)} days sent"
    typer.echo(f"Labelled {len(labelled)} of {sent}: see them with `{{ project_name }} sql \"FROM labels\"`.")
    if missed := [f"{day:%Y-%m-%d}" for day, _ in days if day not in labelled]:
        typer.echo(f"No label for {', '.join(missed)}: Claude gave none, or the day was labelled by hand meanwhile. "
                   "Run it again for the days with no label.")
{%- endif %}


def status_lines(con: duckdb.DuckDBPyConnection) -> list[str]:
    """What `status` says about the data, before the contract check."""
    days = con.execute("SELECT count(*), min(day), max(day) FROM v_daily").fetchone()
    last = con.execute("SELECT strftime(max(started_at), '%Y-%m-%d %H:%M') FROM v_ingests WHERE ok").fetchone()[0]
{%- if curations %}
    labels = con.execute("SELECT count(*), count(*) FILTER (classified_by = 'manual') FROM labels").fetchone()
    return [f"Days:         {days[0]:,}, {days[1]} → {days[2]}", f"Last ingest:  {last or 'never'}",
            f"Labels:       {labels[0]:,} ({labels[1]:,} by hand), kept in curated/"]
{%- else %}
    return [f"Days:         {days[0]:,}, {days[1]} → {days[2]}", f"Last ingest:  {last or 'never'}"]
{%- endif %}


add_standard_commands(
    app, SPEC, connect=connect, status=status_lines,
    backups={{ backup }}, publishing={{ motherduck }},{% if curations %} curations=True,{% endif %}
)
