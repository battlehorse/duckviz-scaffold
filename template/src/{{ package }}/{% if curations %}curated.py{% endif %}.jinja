"""This app's curated decisions: the tables whose decisions are kept in curated/*.csv, committed to git
(curated/README.md, duckkit.curated).

The database holds the decisions. The files are their backup. A command that changes a decision calls `export` when
it is done. `ingest` calls `restore`, which loads the files into a rebuilt database. Add a table here when the app
gets a new kind of decision.
"""

import duckdb
from duckkit import curated
from duckkit.curated import CuratedTable

from {{ package }}.spec import SPEC

TABLES = [
    CuratedTable("labels", ("day", "label", "classified_by", "classified_at", "note"), order_by="day"),
]


def export(con: duckdb.DuckDBPyConnection) -> None:
    """Write the curated tables to curated/. Call it at the end of every command that changes a decision. It refuses
    a demo database."""
    curated.export(con, SPEC.curated_dir, TABLES)


def restore(con: duckdb.DuckDBPyConnection) -> dict[str, int] | None:
    """Load curated/ into a database that holds no decisions yet (a rebuilt one). Returns the rows per table, or
    None."""
    return curated.restore(con, SPEC.curated_dir, TABLES)
