<!doctype html>
<!-- Where a hosted app sends an idle tab (duckkit.app.common.watch_idle): a plain page with no live connection, so
     Cloud Run can stop. Served by Streamlit's static serving (--server.enableStaticServing in the Dockerfile). -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Paused · {{ title }}</title>
<style>
  :root { color-scheme: light dark; --bg: #ffffff; --fg: #0b0b0b; --muted: #52514e; --link: #1c5cab; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0e1117; --fg: #fafafa; --muted: #a3a29c; --link: #86b6ef; }
  }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--fg);
         font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 26rem; padding: 0 16px; text-align: center; }
  h1 { font-size: 1.5rem; margin: 0 0 .5rem; }
  p { color: var(--muted); margin: 0 0 1.5rem; }
  a { display: inline-block; padding: .6rem 1.4rem; border-radius: .5rem; background: var(--link); color: var(--bg);
      text-decoration: none; font-weight: 600; }
</style>
</head>
<body>
<main>
  <h1>Paused</h1>
  <p>The app paused after a while without activity, so it can stop running in the cloud.</p>
  <a id="resume" href="/">Resume</a>
</main>
<script>
  // Back to the page the tab was on: only a path on this site.
  const back = new URLSearchParams(location.search).get("back");
  if (back && /^\/(?![\/\\])/.test(back)) document.getElementById("resume").href = back;
</script>
</body>
</html>
