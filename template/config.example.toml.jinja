# Copy to config.toml (gitignored) and fill in. Everything personal lives in config.toml only.
# Environment variables override it (MOTHERDUCK_TOKEN, {{ env_prefix }}_DB, …).
{%- if backup %}

[backup]
dir = "backups"      # Parquet snapshots; relative to the project, or absolute (a synced folder, say)
keep = 30            # newest snapshots kept, here and in Cloud Storage
remote = ""          # optional: "gs://<bucket>", a private bucket for a copy off this machine (/backup setup-remote)
{%- endif %}
{%- if motherduck %}

[motherduck]
token = ""           # optional: `{{ project_name }} publish` (MotherDuck → Settings → Access tokens)
{%- endif %}
{%- if (curations and llm) or ask %}

[anthropic]
{%- set users = ([] if not (curations and llm) else ['`' ~ project_name ~ ' classify`']) + (['the Ask window'] if ask else []) %}
api_key = ""         # {{ users | join(' and ') }} (console.anthropic.com → API keys). It costs money: set a spending limit.
{%- if ask %}
model = "claude-opus-5-5"     # the Ask window's default model: claude-opus-5-5 or claude-sonnet-5-5
effort = "medium"             # the Ask window's effort, how hard Claude thinks: low, medium, high, xhigh or max
max_conversation_cost = 2     # $: past this, a conversation stops and asks for a new one (docs/guides/ask.md)
{%- endif %}
{%- endif %}

[privacy]
terms = []           # more words `privacy-check` refuses in committed files (names, places)
