    if not db.exists():
        pytest.skip("no real database on this machine: run `/ingest`")
    con = duckdb.connect(str(db), read_only=True)
    if SPEC.timezone:
        con.execute(f"SET TimeZone = '{SPEC.timezone}'")
    yield con
    con.close()


def test_the_real_database_conforms(real):
    """The real database fits the contract that the app reads."""
    assert SPEC.contract.check(real) == []
