"""Labels chosen by Claude (`classify`), against a fake client: no network, no key, no cost."""

from datetime import date

import pytest
from duckkit.llm import Claude
from duckkit.testing import FakeAnthropic, claude_reply
from typer.testing import CliRunner

from {{ package }} import classify as labeller
from {{ package }}.cli import app
from {{ package }}.db.store import connect
from {{ package }}.spec import SPEC

runner = CliRunner()


def ingest(tmp_path) -> None:
    """Six days: a usual value of 4, a day far above it (2026-01-03) and a day far below it (2026-01-05)."""
    path = tmp_path / "sample.csv"
    path.write_text("day,value\n2026-01-01,4\n2026-01-02,5\n2026-01-03,20\n2026-01-04,4\n2026-01-05,1\n2026-01-06,4\n")
    assert runner.invoke(app, ["ingest", str(path)]).exit_code == 0


def labels(con) -> list[tuple]:
    return con.execute("SELECT strftime(day, '%Y-%m-%d'), label, classified_by FROM labels ORDER BY day").fetchall()


def test_only_the_days_that_stand_out_and_have_no_label_are_sent(tmp_path):
    ingest(tmp_path)
    assert runner.invoke(app, ["label", "2026-01-05", "holiday"]).exit_code == 0
    with connect() as con:
        assert [f"{day:%Y-%m-%d}" for day, _ in labeller.days_to_label(con)] == ["2026-01-03"]


def test_the_answers_are_stored_as_the_models_decisions(tmp_path):
    ingest(tmp_path)
    client = FakeAnthropic(claude_reply({"days": [{"index": 0, "label": "unusual use"},
                                                  {"index": 1, "label": "holiday"}]}))
    with connect() as con:
        days = labeller.days_to_label(con)
        assert labeller.classify(con, Claude(SPEC, client=client), days) == 2
        assert labels(con) == [("2026-01-03", "unusual use", "llm"), ("2026-01-05", "holiday", "llm")]
    sent = client.requests[0]["messages"][0]["content"]
    assert "0. 2026-01-03 (Saturday): 20" in sent and "1. 2026-01-05 (Monday): 1" in sent


@pytest.mark.spec
def test_a_label_set_by_hand_is_never_changed_by_the_model(tmp_path):
    """An answer of the model never changes a label set by hand."""
    ingest(tmp_path)
    assert runner.invoke(app, ["label", "2026-01-03", "party"]).exit_code == 0
    client = FakeAnthropic(claude_reply({"days": [{"index": 0, "label": "meter fault"}]}))
    with connect() as con:
        assert labeller.classify(con, Claude(SPEC, client=client), [(date(2026, 1, 3), 20.0)]) == 0
        assert labels(con) == [("2026-01-03", "party", "manual")]


@pytest.mark.spec
def test_classify_without_yes_sends_nothing(tmp_path, monkeypatch):
    """Without --yes, `classify` shows what it would send and cost, and sends nothing (it costs money)."""
    ingest(tmp_path)
    monkeypatch.setattr("duckkit.llm.Claude", lambda *a, **k: pytest.fail("Claude was called without --yes"))
    result = runner.invoke(app, ["classify"])
    assert result.exit_code == 0, result.output
    assert "2 days" in result.output and "Nothing was sent" in result.output
    assert "classify --yes" in result.output


def test_classify_without_a_key_says_where_to_put_it(tmp_path):
    ingest(tmp_path)
    result = runner.invoke(app, ["classify", "--yes"])
    assert result.exit_code == 1
    assert "[anthropic] api_key" in result.output
