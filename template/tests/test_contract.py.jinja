"""The contract is fully described, and docs/contract.md documents every view and column."""

from duckkit.testing import guard

from {{ package }}.spec import SPEC


def test_every_view_and_column_is_described():
    for view, (about, columns) in SPEC.contract.descriptions().items():
        assert about, view
        assert all(columns.values()), view


def test_the_doc_describes_every_view_and_column():
    assert guard.doc_problems(SPEC, SPEC.root / "docs" / "contract.md") == []
