# Lint and test every pull request. Uses only the synthetic data in tests/: no real data, database or token is
# needed (or available) here. A merge to main isn't tested again: its PR was, and a private repo's Actions minutes
# are limited. The next PR's run would show a break that two PRs make only together.
name: tests

on:
  pull_request:
    # edited: a PR's base can change (a stacked PR retargeted to main), and the spec job must look again
    types: [opened, synchronize, reopened, edited]

jobs:
  test:
    if: github.event.action != 'edited'
    runs-on: ubuntu-latest
    # One run per PR: a new push cancels the run of the one before, whose result no longer matters. An edited
    # event (a new title, body or base) skips this job, and has a group of its own (its run id), so that it can
    # never cancel a test that is running.
    concurrency:
      group: test-${{ '{{' }} github.event.action == 'edited' && github.run_id || github.event.pull_request.number {{ '}}' }}
      cancel-in-progress: true
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v10.3.2
      - name: Install
        run: uv sync --locked
      - name: Lint
        run: uv run ruff check .
      - name: Test
        run: uv run pytest -q --cov={{ package }} --cov-report=term
      - name: Scaffold
        run: uv run {{ project_name }} doctor

  # Labels a PR that touches the spec (docs/work/spec.md) with spec-change. The PR says whether it extends or revises
  # the spec (docs/work/how-we-work.md). Before it merges, Claude reads the PR's *Spec changes* section and the
  # reviewer's answer. It also creates the label merged-by-claude, which Claude adds before a merge on its own.
  spec:
    if: github.event_name == 'pull_request' && (github.event.action != 'edited' || github.event.changes.base)
    runs-on: ubuntu-latest
    concurrency:  # one run per PR: an older run must not set the label after a newer one
      group: spec-${{ '{{' }} github.event.pull_request.number {{ '}}' }}
      cancel-in-progress: true
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@v10.3.2
      - name: Install
        run: uv sync --locked
      - name: Spec diff
        id: diff
        run: |
          set +e
          uv run {{ project_name }} spec-diff --base "origin/${{ '{{' }} github.base_ref {{ '}}' }}"
          code=$?
          set -e
          case $code in
            0) echo "changed=false" >> "$GITHUB_OUTPUT" ;;
            1) echo "changed=true" >> "$GITHUB_OUTPUT" ;;
            *) exit "$code" ;;  # spec-diff could not tell: fail, so the PR does not look safe to merge
          esac
      - name: Label
        env:
          GH_TOKEN: ${{ '{{' }} github.token {{ '}}' }}
          PR: ${{ '{{' }} github.event.pull_request.number {{ '}}' }}
        run: |
          gh label create spec-change --color D93F0B --description "Touches the spec: an extension or a revision (the PR says which)" --force
          gh label create merged-by-claude --color 8957E5 --description "Merged by Claude without the user's review (docs/work/how-we-work.md, The merge rule)" --force
          if [ "${{ '{{' }} steps.diff.outputs.changed {{ '}}' }}" = true ]; then
            gh pr edit "$PR" --add-label spec-change
          else
            gh pr edit "$PR" --remove-label spec-change || true
          fi
